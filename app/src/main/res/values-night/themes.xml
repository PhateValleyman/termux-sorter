<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System dark mode theme override -->
    <style name="Theme.TermuxSorter" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorAccent">@color/termux_green</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_surface</item>
    </style>

    <style name="Theme.TermuxSorter.Dialog" parent="Theme.TermuxSorter">
        <item name="android:windowBackground">@color/background_surface</item>
    </style>
</resources>
